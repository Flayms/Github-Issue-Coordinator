{
  "name": "@flayms/issueflow",
  "version": "0.1.0",
  "description": "Self-hosted daemon that runs Claude Code and other agent CLIs to triage, plan, implement and review GitHub issues, with human approval gates.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flayms/Issueflow.git"
  },
  "type": "module",
  "bin": {
    "issueflow": "src/cli.ts"
  },
  "files": [
    "src/",
    "prompts/",
    "config.schema.json"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "start": "bun src/cli.ts start",
    "test": "bun test",
    "lint": "biome check . && tsc --noEmit",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "doctor": "bun src/cli.ts doctor",
    "screenshots": "bun scripts/dashboard-screenshots.ts",
    "check:pipeline-hover": "bun scripts/pipeline-hover-check.ts",
    "schema": "bun scripts/config-schema.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@tailwindcss/node": "^4.3.5",
    "@tailwindcss/oxide": "^4.3.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  }
}
