# systemd unit for the Coordinator. See docs/setup.md ("Run as a service").
# deploy/setup-vm.sh fills in @USER@, @HOME@ and @CHECKOUT@ and installs it to /etc/systemd/system/.
[Unit]
Description=GitHub Issue Coordinator (Claude Code agents for GitHub issues)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@CHECKOUT@
# claude (~/.local/bin) and bun (~/.bun/bin) are installed per user.
Environment=PATH=@HOME@/.local/bin:@HOME@/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=@HOME@
Environment=COORDINATOR_CONFIG=@CHECKOUT@/config.ts
ExecStart=@HOME@/.bun/bin/bun src/index.ts
Restart=on-failure
RestartSec=30
# Agent sessions live in a tmux server started by the Coordinator. Only stop the Coordinator
# itself on restart; the sessions keep running and are picked up again on the next start.
KillMode=process

[Install]
WantedBy=multi-user.target
