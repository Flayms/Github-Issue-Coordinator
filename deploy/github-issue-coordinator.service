# systemd unit for the Coordinator, running as root from /root/github-issue-coordinator (docs/setup.md).
# Install: sudo cp deploy/github-issue-coordinator.service /etc/systemd/system/ && sudo systemctl daemon-reload
[Unit]
Description=GitHub Issue Coordinator (Claude Code agents for GitHub issues)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/github-issue-coordinator
# claude (~/.local/bin) and bun (~/.bun/bin) are installed per user.
Environment=PATH=/root/.local/bin:/root/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=COORDINATOR_CONFIG=/root/github-issue-coordinator/config.ts
ExecStart=/root/.bun/bin/bun src/index.ts
Restart=on-failure
RestartSec=30
# Agent sessions live in a tmux server started by the Coordinator. Only stop the Coordinator
# itself on restart; the sessions keep running and are picked up again on the next start.
KillMode=process

[Install]
WantedBy=multi-user.target
