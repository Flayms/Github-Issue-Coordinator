{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "ignoreUnknown": true, "includes": ["**", "!.claude", "!.mcp.json", "!CHANGELOG.md"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" }, "domains": { "react": "recommended" } },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "overrides": [{ "includes": ["src/dashboard/assets/**"], "linter": { "domains": { "react": "none" } } }],
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
